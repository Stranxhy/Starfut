# Copia este archivo como .env y ajusta los valores. NO subas .env al repositorio.

# Conexión a PostgreSQL (docker-compose expone el puerto 5433 por defecto)
DATABASE_URL="postgresql://starfutbol:starfutbol_dev@localhost:5433/starfutbol?schema=public"
# Base de datos para pruebas de integración (se crea/limpia automáticamente)
TEST_DATABASE_URL="postgresql://starfutbol:starfutbol_dev@localhost:5433/starfutbol_test?schema=public"

# Secreto para firmar la sesión (mínimo 32 caracteres aleatorios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Administrador inicial creado por `npm run db:seed` (solo si no existe).
ADMIN_EMAIL="admin@starfutbol.local"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD=""

# Zona horaria de la liga (para determinar "hoy", próxima fecha, etc.)
APP_TIMEZONE="America/Mexico_City"
